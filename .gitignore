# Environment
.env

# Python
__pycache__/
*.py[cod]
.venv/
.ruff_cache/
.pytest_cache/
.coverage

# Node (Phase 1)
node_modules/
.next/
next-env.d.ts

# Seed artifacts
# `seed/small/` IS committed — it is the dev-loop dataset and a reviewable
# artifact. `seed/full/` is ~45MB and is regenerated on demand; its byte
# identity is still asserted via seed/CHECKSUMS.txt. See ADR-0004.
seed/full/

# Local scratch
*.tmp
.DS_Store

# Eval response cache — keyed on prompt fingerprint, regenerable, and it would
# otherwise grow a file per question per run per prompt revision.
evals/.cache/

# Service-account keys and other credentials. NEVER commit these — this repo is
# public, and a leaked key is a live key until it is revoked. Broad patterns on
# purpose: a credential named something unanticipated is the one that gets
# committed.
Project_*.json
*service*account*.json
*-sa.json
gcp-*.json
*credentials*.json
*.pem
*.p12
