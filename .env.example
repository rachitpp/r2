# Copy to .env before running anything:  cp .env.example .env
#
# Phase 0 needs no API key. Nothing in this phase calls a model.
# If something asks you for one, something has gone wrong.

# ─── Postgres container ──────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pos
POSTGRES_PORT=5432

# ─── Application database roles ──────────────────────────────────────────────
# Local-only credentials. The database is not reachable outside the compose
# network except on POSTGRES_PORT of the host.

# Read/write. Used by the API and the worker.
POS_APP_PASSWORD=pos_app_dev
DATABASE_URL=postgresql://pos_app:pos_app_dev@localhost:5432/pos

# Read-only. EVERY generated SQL query runs under this role — no exceptions
# (CLAUDE.md rule 4). The role provides read-only enforcement and a statement
# timeout; the row LIMIT is applied by the query wrapper in the API, because
# Postgres has no max-rows setting. See docs/PROGRESS.md.
POS_READONLY_PASSWORD=pos_readonly_dev
READONLY_DATABASE_URL=postgresql://pos_readonly:pos_readonly_dev@localhost:5432/pos

# ─── Seed ────────────────────────────────────────────────────────────────────
# small = 1 store / 180 days, the development loop.
# full  = 3 stores / 546 days, the demo build. ALL EVALS RUN AGAINST full.
# The two are independent datasets, not subset and superset.
SEED_SIZE=small

# ─── Application ─────────────────────────────────────────────────────────────
# The seed data has a fixed end date so it can be byte-identical on re-run.
# AS_OF_DATE is what the application means by "today". It must match
# DATA_END_DATE in api/scripts/seed.py, and eval expected result sets are
# computed against it — never against wall-clock.
AS_OF_DATE=2026-06-30

# Row cap applied by the read-only query wrapper. Matches the default stated
# in api/prompts/sql_generate.md.
SQL_MAX_ROWS=100

# Port the query API serves on (`make serve`).
API_PORT=8000

# true  — /query answers from api/demo/queries.json. No key, no quota, no
#         network, and deterministic by construction, which is what ADR-0001's
#         resolution rests on. `make serve`.
# false — /query generates SQL with the model named below, using YOUR
#         credentials. `make serve-live`. The demo path is not replaced.
DEMO_MODE=true

# Ceilings on the live path, per CLAUDE.md rule 2: every runner carries a call
# ceiling and a spend ceiling, and this runner's loop is held by whoever is
# holding the browser's refresh key. The 47x3 measurement cost ~$0.02 a call.
# Blank means "use the default" — 50 calls, $1.00.
LIVE_MAX_CALLS=50
LIVE_MAX_SPEND_USD=1.00

# ─── Models ──────────────────────────────────────────────────────────────────
# Roles resolve from here; never hardcode a model string at a call site.
# Pin an EXACT version — a floating alias makes a result file describe nothing.
#
# Data terms drive the split, not rate limits: the Gemini free tier trains on
# your prompts and has humans read them, so real documents go to Vertex in
# Phase 2. See ADR-0009.
MODEL_PLAN=gemini-3.6-flash
MODEL_CLASSIFY=gemini-3.5-flash-lite

# Vertex, and a service account rather than the key below. `make extract` refuses
# to run until this is set, because an extraction result that cannot name the
# model that produced it describes nothing. `make extract-stub` needs none of it.
MODEL_EXTRACT=gemini-3.6-flash

# The service-account JSON for the Vertex path. `model.py` reads this and fails
# with "No credential" without it, so `make extract` cannot run on a checkout
# that has only the key above. This line was missing from this file until
# 2026-08-12, which made the one variable the paid path needs the one variable
# nothing documented.
#
# Absolute path to the downloaded JSON. Keep the file OUTSIDE the repo.
GOOGLE_APPLICATION_CREDENTIALS=

# Serving location. `gemini-3.6-flash` answers from `global` ONLY — measured
# 404 in us-central1 and asia-south1. See ADR-0006; the location is part of the
# pin, not just the model string.
VERTEX_LOCATION=global

# Requests per minute for the eval pacer. Set from YOUR project's actual limit
# in AI Studio, not from a blog table. Too high just means 429s and backoff.
GEMINI_RPM=10

# Evals cost quota and never run in CI. Leave unset for demo mode.
GEMINI_API_KEY=

# ─── Windows only ────────────────────────────────────────────────────────────
# `make ingest` needs both of these on Windows and neither anywhere else. They
# are no-ops on Linux and macOS and in CI, so they are safe to leave set.
#
# Uncomment on Windows. Without them the failures are confusing rather than
# obvious: a permissions error from deep inside hf_hub, and a missing-compiler
# error naming MSVC rather than anything in this project.
#
# hf_hub creates symlinks in its cache, which needs admin or Developer Mode.
# HF_HUB_DISABLE_SYMLINKS=1
#
# TorchInductor shells out to MSVC `cl.exe`, which is not present on a
# checkout that never installed Visual Studio build tools.
# TORCHDYNAMO_DISABLE=1
